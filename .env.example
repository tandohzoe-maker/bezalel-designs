# ── Public site ────────────────────────────────────────────────
# Canonical URL used for SEO metadata, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Optional overrides for the contact details in src/config/site.ts
# (e.g. for a staging site). Leave unset to use the real details.
# Numbers in international or local Ghana format, e.g. +233241234567 or 0241234567
NEXT_PUBLIC_PHONE_NUMBER=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_BUSINESS_EMAIL=
NEXT_PUBLIC_BUSINESS_LOCATION=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_LINKEDIN_URL=
